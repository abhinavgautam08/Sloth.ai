# Sloth.ai Environment Configuration Example
# Copy this file to .env to customize local variables.
# Never commit real API keys, credentials, or private secrets.

# Ollama local inference endpoint
OLLAMA_HOST=http://localhost:11434

# Default target open-weight model (e.g. llama3.2, codellama:latest, mistral, phi3)
DEFAULT_MODEL=codellama:latest

# Document upload limit in bytes (Default: 10 MB = 10485760 bytes)
MAX_UPLOAD_SIZE_BYTES=10485760

# Backend service port
PORT=8000
